# Firebase Web App Configuration
# Get these credentials from Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Firebase Cloud Messaging Web Push VAPID Key
# Get this from Firebase Console > Project Settings > Cloud Messaging > Web configuration > Key pair
VITE_FIREBASE_VAPID_KEY=your_fcm_vapid_key_here
